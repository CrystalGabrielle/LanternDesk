# =============================================================================
# LAN Library 配置模板
# 用法：cp .env.example .env，然后按实际情况修改。.env 已被 .gitignore 忽略。
# =============================================================================

# 站点绑定地址：必须是本机的【局域网 IP】，不要用 0.0.0.0。
# 服务端还会拒绝一切非私有网段的请求，双重保证「仅内网」。
HOST_IP=192.168.1.10

# 对外端口（同一局域网内的浏览器访问 http://HOST_IP:PORT）
PORT=8090

# -----------------------------------------------------------------------------
# 资料目录的【父目录】，容器会把它整体挂载到 /lanpublic
# 真正的书库根目录 = ${PUBLIC_HOST}/${LIBRARY_SUBDIR}
# 例如 PUBLIC_HOST=/srv/books、LIBRARY_SUBDIR=学习资料
#   => 书库根目录 /srv/books/学习资料
#
# 重要：分类镜像（硬链接）也生成在这个父目录下，
# 因此父目录必须与资料目录位于同一个文件系统/挂载点，否则硬链接会失败。
# -----------------------------------------------------------------------------
PUBLIC_HOST=./library-data
LIBRARY_SUBDIR=学习资料

# 应用自身数据：SQLite 索引、阅读进度、书签、AI 设置与封面缓存
# 相对路径以 docker-compose.yml 所在目录为基准
DATA_HOST=./data

# 自动扫描间隔（分钟），也可在网页上手动点「同步」
SCAN_INTERVAL_MIN=10
